<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">

  <title>ATS Tap Router</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">

  <style>
    html,
    body{
      margin:0;
      padding:0;
      width:100%;
      height:100%;
      background:#0f172a;
      color:#fff;
      font-family:Arial,sans-serif;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .wrap{
      text-align:center;
    }

    .title{
      font-size:20px;
      font-weight:700;
      margin-bottom:10px;
    }

    .sub{
      opacity:.7;
      font-size:14px;
    }
  </style>
</head>
<body>

<div class="wrap">
  <div class="title">About To Shine</div>
  <div class="sub">Opening ATS...</div>
</div>

<script>
(function(){

  const params = new URLSearchParams(window.location.search);

  const token = (params.get("t") || "").trim();

  // ---------------------------------------------------
  // NO TOKEN
  // ---------------------------------------------------

  if (!token) {
    location.replace("/admin/");
    return;
  }

  // ---------------------------------------------------
  // STORE TOKEN FOR SESSION
  // ---------------------------------------------------

  try {
    sessionStorage.setItem("ats_token", token);
    localStorage.setItem("ats_token", token);
  } catch (err) {}

  // ---------------------------------------------------
  // FUTURE SMART ROUTING PLACEHOLDER
  // ---------------------------------------------------
  //
  // Future ideas:
  //
  // - detect active job
  // - detect time of day
  // - detect night accounts
  // - detect GPS proximity
  // - dispatch next active job
  // - admin dashboard routing
  // - payroll/admin redirect logic
  //
  // ---------------------------------------------------

  // ---------------------------------------------------
  // CURRENT ROUTE
  // ---------------------------------------------------

  location.replace(
    "/admin/my-weekly-board/?t=" +
    encodeURIComponent(token)
  );

})();
</script>

</body>
</html>
